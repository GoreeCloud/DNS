# Local-only development example. Never commit real API credentials.
DNS_API_TOKEN=
# auto forwards using client-aware UDP/TCP, tcp forces TCP, tls uses verified upstream DoT.
DNS_UPSTREAM_MODE=auto
DNS_UPSTREAM_TLS_NAME=
DNS_UPSTREAM_TLS_CA_FILE=
DNS_MAX_CONCURRENT=128

# The native daemon defaults to loopback-only DNS clients; use explicit LAN CIDRs.
DNS_ALLOWED_CIDRS=127.0.0.0/8,::1/128

# Optional local-only A/AAAA/CNAME exact-name overrides.
DNS_LOCAL_RECORDS_FILE=config/local-records.txt

# Stateless global DNS query budget (no per-client history).
DNS_RATE_QPS=500
DNS_RATE_BURST=1000

# Management API defaults to localhost-only HTTP. For remote TLS:
DNS_API_TLS_CERT_FILE=
DNS_API_TLS_KEY_FILE=
# Only for explicitly isolated loopback-published development containers.
DNS_API_ALLOW_INSECURE_REMOTE=false
