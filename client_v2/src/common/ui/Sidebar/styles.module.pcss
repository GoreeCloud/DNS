.sidebarWrapper {
    display: block;
    min-width: 240px;

    @media (min-width: 1200px) {
        align-self: stretch;
        background-color: var(--page-background-additional);
    }
}

.sidebarContainer {
    display: none;
    flex-shrink: 0;

    @media (min-width: 1200px) {
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 0;
        width: 100%;
        max-width: 240px;
        height: 100vh;
        padding: 16px 0;
        overflow-y: auto;
        z-index: 1;
        background-color: var(--page-background-additional);
    }

    &::-webkit-scrollbar {
        display: none;
    }
}

.sidebar {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 160px;
    min-height: 30px;
    white-space: nowrap;
    color: var(--default-logo-color);
}

.brandMark {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    border-radius: 9px;
    background: var(--default-logo-color);
    color: var(--page-background-additional);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: -0.06em;
}

.brandText {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1;
}

.brandName {
    font-size: 16px;
    font-weight: 750;
    letter-spacing: -0.04em;
}

.brandProduct {
    color: var(--default-description-text);
    font-size: 10px;
    font-weight: 650;
    letter-spacing: 0.18em;
}

.linkWrapper {
    display: flex;
    padding: 12px 16px 32px;
}

.link {
    text-decoration: none;
}

.logoCompany {
    fill: var(--default-logo-color);
}

.logoProduct {
    fill: var(--default-description-text);
}
